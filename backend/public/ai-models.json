{
  "version": 1,
  "default_provider": "google_ai",
  "providers": {
    "google_ai": {
      "default_model": "gemini-3.5-flash-lite",
      "models": [
        "gemini-3.5-flash-lite",
        "gemini-3.8-flash"
      ],
      "generation_config": {
        "temperature": 0.5,
        "thinkingConfig": {
          "thinkingLevel": "MEDIUM"
        }
      },
      "model_overrides": {
        "gemini-flash-latest": {
          "thinkingConfig": {
            "thinkingLevel": "LOW"
          }
        }
      }
    },
    "openrouter": {
      "default_model": "openrouter/free",
      "models": [
        "openrouter/free",
        "openrouter/auto"
      ],
      "generation_config": {
        "max_tokens": 4096,
        "reasoning": {
          "effort": "low"
        }
      }
    }
  }
}
