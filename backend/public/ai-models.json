{
  "version": 1,
  "default_provider": "google_ai",
  "providers": {
    "google_ai": {
      "default_model": "gemini-flash-latest",
      "models": [
        "gemini-flash-latest",
        "gemini-flash-lite-latest",
        "gemini-3.6-flash"
      ],
      "generation_config": {
        "thinking_level": "low"
      }
    },
    "openrouter": {
      "default_model": "openrouter/free",
      "models": [
        "openrouter/free",
        "openrouter/auto",
        "google/gemini-3.6-flash"
      ],
      "generation_config": {
        "max_tokens": 4096,
        "reasoning": {
          "effort": "low"
        }
      }
    }
  }
}
